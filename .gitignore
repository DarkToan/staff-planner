.expo/
.tamagui/
.cache/
.metro-health-check*
expo-env.d.ts
tamagui.generated.css
*.tsbuildinfo

# Build and test output (static samples in public/exports stay tracked)
/dist/
/web-build/
/coverage/
/.nyc_output/
/test-results/
/playwright-report/
