.vercel/

# Local environment configuration; sanitized templates may be shared
.env
.env.*
!.env.example

# Logs, temporary files, and local signing credentials
*.log
*.tmp
*.swp
*.swo
*~
*.pem
*.key
*.p8
*.p12
*.pfx
*.keystore
*.mobileprovision

# OS and personal editor artifacts; keep the shared workspace configuration
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/*
!.vscode/tasks.json
!.vscode/settings.json
!.vscode/extensions.json